{
  "name": "by-bjarnar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "i:build": "infisical run pnpm build",
    "build:clean": "rm -rf .next && rm -rf next-env.d.ts && pnpm build",
    "i:build:clean": "infisical run pnpm build:clean",
    "dev": "next dev --turbopack",
    "i:dev": "infisical run pnpm dev",
    "dev:clean": "rm -rf .next && rm -rf next-env.d.ts && pnpm dev",
    "i:dev:clean": "infisical run pnpm dev:clean",
    "start": "next start",
    "i:start": "infisical run pnpm start",
    "migrate": "payload migrate",
    "i:migrate": "infisical run pnpm migrate",
    "migrate:create": "payload migrate:create",
    "i:migrate:create": "infisical run pnpm migrate:create",
    "migrate:clean": "rm -rf src/payload/migrations/* && touch src/payload/migrations/.gitkeep",
    "migrate:dev": "pnpm migrate:clean && pnpm i:migrate:create && pnpm i:migrate",
    "generate:importmap": "infisical run payload generate:importmap",
    "generate:types": "infisical run payload generate:types",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --fix",
    "lint:check": "oxlint --type-aware",
    "stylelint": "stylelint '**/*.css' --fix --ignore-path .gitignore",
    "stylelint:check": "stylelint '**/*.css' --ignore-path .gitignore",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@payloadcms/db-postgres": "3.81.0",
    "@payloadcms/email-resend": "3.81.0",
    "@payloadcms/live-preview-react": "3.81.0",
    "@payloadcms/next": "3.81.0",
    "@payloadcms/plugin-nested-docs": "3.81.0",
    "@payloadcms/richtext-lexical": "3.81.0",
    "@payloadcms/storage-s3": "3.81.0",
    "@payloadcms/ui": "3.81.0",
    "@react-email/components": "^1.0.11",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-pacer": "^0.20.0",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-table": "^8.21.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.13.2",
    "nanoid": "^5.1.7",
    "next": "16.2.3",
    "payload": "3.81.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.10.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "validator": "^13.15.35",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query-devtools": "^5.96.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/validator": "^13.15.10",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.19.0",
    "stylelint": "^17.6.0",
    "stylelint-config-clean-order": "^8.0.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.0"
}
